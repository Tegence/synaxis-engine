# Synaxis Engine config (copy to .env for local runs; on Cloud Run these are
# set as service env vars). The engine is the whole backend — there is no
# separate MetaMCP service anymore.

# --- server ---
# Cloud Run sets PORT; locally ENGINE_PORT is the override (default 8080).
ENGINE_PORT=8080
# The engine's own public base URL (issuer for its OAuth AS). Locally this is
# the localhost URL; in prod it's the Cloud Run service URL.
ENGINE_ISSUER=http://localhost:8080

# --- auth / crypto (REQUIRED in prod) ---
# Console + OAuth consent password. Use a strong random value.
ENGINE_PASSWORD=
# HMAC secret for OAuth AS tokens + console sessions. >=32 random chars.
ENGINE_SECRET=
# Optional hosted consent delegation. Configure both values together. The URL
# receives an opaque five-minute request token; the key is the standard base64
# encoding of Platform's raw 32-byte Ed25519 public key. When unset, Engine
# keeps the self-hosted password consent form.
ENGINE_CONSENT_URL=
ENGINE_CONSENT_PUBLIC_KEY=
# Password /api/login and locally signed management sessions. Defaults true
# for self-hosting. Hosted provisioners must set false; machine bearer access
# through SYNAXIS_ADMIN_TOKEN remains available.
ENGINE_LOCAL_ADMIN_AUTH_ENABLED=true
# Machine-to-machine credential for a trusted Synaxis control plane. This
# grants access to protected /api management endpoints and must never be sent
# to a browser. ENGINE_ADMIN_TOKEN remains a backwards-compatible alias; when
# both are set, SYNAXIS_ADMIN_TOKEN wins.
SYNAXIS_ADMIN_TOKEN=
# ENGINE_ADMIN_TOKEN=
# Legacy password-bearing /admin forms remain available for self-hosted
# compatibility. Hosted provisioners must set this to false.
SYNAXIS_ENABLE_LEGACY_ADMIN=true
# ENGINE_ENABLE_LEGACY_ADMIN=true
# AES-256 key (base64, 32 bytes) for encrypting tokens at rest. Generate with:
#   openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
# If unset, tokens are stored unencrypted (dev only). NEVER lose this in prod —
# losing it makes every stored token unrecoverable.
ENGINE_ENCRYPTION_KEY=

# --- storage ---
# Postgres connection. If unset, the engine uses a local JSON FileStore.
# DATABASE_URL=postgres://user:pass@host:5432/dbname?sslmode=disable
# FileStore path when DATABASE_URL is unset.
ACCOUNTS_PATH=accounts.json

# --- console (the Next.js frontend) ---
# Where to bounce the browser after an upstream OAuth connect.
CONSOLE_URL=http://localhost:3000
# CORS allowlist for the console API (comma-separated origins).
CONSOLE_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# --- alerting (optional) ---
# Slack/Discord webhook for account down/recovered alerts. If unset, alerts
# are logged only.
ALERT_WEBHOOK_URL=

# --- approvals / flight recorder (optional) ---
# How long an approval-gated tool call waits for a console decision (seconds).
APPROVAL_TIMEOUT_SECONDS=180
# "true" records args/result payloads for calls on the default /mcp endpoint
# (virtual connectors opt in per-connector via their Record toggle instead).
ENGINE_RECORD_PAYLOADS=
# Purge audit rows older than this many days (Postgres store; 0 = keep forever).
AUDIT_RETENTION_DAYS=30
