{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synaxis.tools/schemas/library/activation-bundle.v1.schema.json",
  "title": "Synaxis Library activation bundle v1",
  "description": "Portable, context-only activation data returned by library_skill_activation. This schema validates the wire shape; a host must also verify the SHA-256 digests, canonical capability ordering, and host-policy limits with its runtime adapter before use.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "agentSurface",
    "skills",
    "bundleDigest",
    "authorityNotice",
    "hostResponsibilities"
  ],
  "properties": {
    "contractVersion": {
      "const": "synaxis.library.activation.v1"
    },
    "agentSurface": {
      "$ref": "#/$defs/agentSurface"
    },
    "skills": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/skill"
      }
    },
    "bundleDigest": {
      "$ref": "#/$defs/sha256"
    },
    "authorityNotice": {
      "const": "This activation bundle is context only. It grants no credentials, OAuth scopes, permissions, tools, connection access, or effective capabilities. Independently authorize and enforce policy for every action."
    },
    "hostResponsibilities": {
      "const": [
        "Decide whether and how to place these instructions into a host-model turn; Synaxis Engine does not inject or execute them in a third-party host.",
        "Verify each instruction body against contentDigest before use and reject an unsupported contractVersion.",
        "Independently authenticate and enforce every tool, connection, credential, and capability policy immediately before an action; requestedCapabilities and capabilityCeiling are constraints, never grants."
      ]
    }
  },
  "$defs": {
    "opaqueRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "description": "Opaque Engine identifier. Hosts must not treat it as a credential, identity, endpoint URL, or grant."
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "capability": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.:-]{0,127}$"
    },
    "capabilities": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/capability"
      },
      "description": "Capability constraints, never effective grants. The runtime adapter additionally requires lowercase lexical ordering."
    },
    "agentSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "const": "mcp_client"
        },
        "id": {
          "$ref": "#/$defs/opaqueRef"
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "mode",
        "priority"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/opaqueRef"
        },
        "mode": {
          "enum": [
            "pin",
            "track"
          ]
        },
        "priority": {
          "type": "integer"
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestedCapabilities",
        "capabilityCeiling"
      ],
      "properties": {
        "requestedCapabilities": {
          "$ref": "#/$defs/capabilities"
        },
        "capabilityCeiling": {
          "$ref": "#/$defs/capabilities"
        }
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skillId",
        "skillSlug",
        "skillName",
        "versionId",
        "version",
        "instructions",
        "contentDigest",
        "binding",
        "constraints"
      ],
      "properties": {
        "skillId": {
          "$ref": "#/$defs/opaqueRef"
        },
        "skillSlug": {
          "$ref": "#/$defs/opaqueRef"
        },
        "skillName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "versionId": {
          "$ref": "#/$defs/opaqueRef"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "instructions": {
          "type": "string",
          "minLength": 1,
          "description": "Exact immutable instruction text. contentDigest is SHA-256 over its UTF-8 bytes."
        },
        "contentDigest": {
          "$ref": "#/$defs/sha256"
        },
        "binding": {
          "$ref": "#/$defs/binding"
        },
        "constraints": {
          "$ref": "#/$defs/constraints"
        }
      }
    }
  }
}
